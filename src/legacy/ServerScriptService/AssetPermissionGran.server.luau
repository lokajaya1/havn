end

print("\n========== SELESAI ==========")
print("Berhasil di-grant : " .. success)
print("Gagal             : " .. failed)

if #failedList > 0 then
	print("\nAsset ID yang GAGAL:")
	for _, id in ipairs(failedList) do
		print("  - " .. id)
	end
end